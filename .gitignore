# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.vscode

# testing
/coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem
*.tsbuildinfo
.eslintcache
.node_repl_history
.npm/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# infrastructure config — sensitive IPs/credentials live in %APPDATA%\unenter\config.json
# The /config/ folder at project root is just forwarding re-exports; exclude it entirely
# so no future edits can accidentally reintroduce credentials here.
/config/

# Project specific logs and dumps
*.dump
errors.txt
lastbuildlogs.ps

# agents
.agents/

# AI tool local configs
.gemini/
.letta/

# logs & debug output
tui_debug.log
tuibuildlogs.md
*.log

# scratch / temp / runtime state
scratch/
state/
sandbox/

# backup & generated files
*.bak
snapshopts.txt
RUNTIME_PRIMITIVES_PREP_REPORT.md

# binary blobs that don't belong in source control
rclone.zip
*.zip

# skills lock (machine-local)
skills-lock.json

# local infrastructure config (IPs, sensitive data — never commit)
config.json
