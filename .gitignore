# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.vscode

# testing
/coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem
*.tsbuildinfo
.eslintcache
.node_repl_history
.npm/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# infrastructure config -- sensitive IPs/credentials live in %APPDATA%\unenter\config.json
# The /config/ folder at project root is just forwarding re-exports; exclude it entirely
# so no future edits can accidentally reintroduce credentials here.
/config/

# credential snapshot files -- never commit these
.credentials.json
*.credentials.json

# TUI structured logs -- local only
logs/
*.ndjson

# Project specific logs and dumps
*.dump
errors.txt
lastbuildlogs.ps

# agents
.agents/

# AI tool local configs
.gemini/
.letta/

# logs & debug output
tui_debug.log
tuibuildlogs.md
*.log

# scratch / temp / runtime state
scratch/
/state/
sandbox/

# backup & generated files
backups/
*.bak
snapshopts.txt
RUNTIME_PRIMITIVES_PREP_REPORT.md

# -- Supabase runtime data -----------------------------------------------------
# supabase-core/ is cloned from github.com/supabase/supabase on first run via
# initializeSupabaseCore(). ~300 MB, fully reproducible, no project config.
supabase-core/

# supabase-instances/ holds live runtime Docker stacks per tenant instance.
# Contains .env (Postgres/JWT secrets), volumes/db (binary data), kong.yml
# (dashboard credentials), mcp-config.json (real API keys). Never commit.
supabase-instances/

# Temporary operational scripts generated during ops sessions
cleanup-*.ps1

# binary blobs that don't belong in source control
rclone.zip
*.zip

# skills lock (machine-local)
skills-lock.json

# local infrastructure config (IPs, sensitive data -- never commit)
config.json
