# NOTE: keep this file LF-only. CRLF endings make every pattern (e.g.
# "node_modules\r") match nothing, so the whole repo — node_modules, .next,
# .git — ends up in the build context (~1.7GB) and starves the build.

# Dependencies (the image runs its own `bun install`)
node_modules
.pnp
.pnp.js

# Build output
**/.next
**/.next/**
.next
out
build
dist

# Lockfiles (Bun regenerates inside the container)
yarn.lock
package-lock.json
npm-debug.log*

# Env files — never bake secrets into the image
.env
.env.local
.env.*.local

# VCS + dev tooling
.git
.gitignore
.eslintcache
*.md
!README.md

# Supabase local dev artifacts
supabase/.branches
supabase/.temp

# Zone overlays — the core app build doesn't need them, BUT zone builds share
# this repo-root context and COPY zones/<key>/src/app/ (see zones/*/Dockerfile).
# Exclude the bulk, re-include every zone's source overlay. Keep the directory
# chain visible so Docker can traverse newly scaffolded zones; hard-coding
# today's zone names breaks the one-click creation pipeline.
zones/**
!zones/**/
!zones/unenter/src
!zones/unenter/src/**

# Platform packages — agent + updater have their own build contexts
packages/

# Swarm / orchestration configs — host-side only
swarm-orchestration/

# OS
.DS_Store
Thumbs.db

# Non-app artifacts — not imported by the Next.js app
backups
.snapshots
snapshots
*.dump
vault
.obsidian
.obsidian-agent
.vault-operator
.agents
.letta
.gemini
.tmp
__pycache__
.turbo
.vercel
.claude
.codex
.codex-tmp
.cursor
.ok
.openclaw-scratch
.trash
.vscode
coturn
mediamtx
openclaw
automations
Architecture
users
memory
logs

# Worker services build from the REPO ROOT context (unlike tank-audio-worker,
# which uses its own directory), because they import the shared decoder and
# detection catalog from src/zones/tank/ by relative path rather than keeping a
# second copy. A bare `services` exclusion made every COPY in
# services/tank-vision-worker/Dockerfile fail. Same shape as the zones block
# below: exclude the files, keep the directory chain traversable, re-include
# only what an image actually needs.
services/**
!services/**/
!services/tank-vision-worker/src
!services/tank-vision-worker/src/**
!services/tank-vision-worker/package.json
!services/tank-vision-worker/tsconfig.json
!services/tank-vision-worker/bun.lock
# The OSNet-AIN re-id model: names people from the graded gallery (galleryNaming.ts).
!services/tank-vision-worker/models
!services/tank-vision-worker/models/osnet_ain_x1_0.onnx
# The AI-mode learner: its python package and tools only. Its weights, graded
# gallery, run state and .venv are bind-mounted, never shipped in the image.
!services/tank-vision-gpu/tank_vision
!services/tank-vision-gpu/tank_vision/**
!services/tank-vision-gpu/tools
!services/tank-vision-gpu/tools/**
services/tank-vision-gpu/**/__pycache__/**
*.tsbuildinfo

# ── Non-app repo cruft — host-only tooling, vendored clones, dumps, scratch ──
# The core image only needs src/, public/, zones/ overlays, i18n/, and config
# files. Everything below is host-side and just bloats the build context (the
# vendored Supabase monorepo clone alone is hundreds of MB) and slows every
# build. The TUI references supabase-core/ etc. by path on the HOST, not from
# inside the container, so excluding them here is safe for the app build.
supabase-core
supabase-instances
github.com
proxy
proxy-config
scratch
sandbox
state
docs

# Archives, host logs, PowerShell scripts, scratch files (*.dump already above)
*.bak
*.zip
*.ps
*.ps1
*.log
errors.txt
snapshopts.txt

# Editor / skill / scratch artifacts
*.skill
*.canvas
*.base
Untitled.*

# Secrets — never bake into an image
claude_desktop_config.json
!src/zones/docs/content/*.md

# Agent image needs the unified agent module (packages/agent-node/Dockerfile
# COPYs it from repo-root context) — re-include despite the proxy/ exclusion.
!proxy/agent.js
