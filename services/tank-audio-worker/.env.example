# Server-only. Never use NEXT_PUBLIC_ names here.
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=
TANK_AUDIO_WORKER_ID=power-room-audio-1
TANK_AUDIO_CACHE_DIR=/var/cache/tank-audio
TANK_AUDIO_POLL_MS=750
TANK_AUDIO_MAX_CONCURRENCY=4

# JSON object keyed by stable tank_rooms.room_key.
# PipeWire example: {"game-room":{"driver":"pipewire","sink":"42","volume":0.85}}
# PulseAudio example: {"living-room":{"driver":"pulse","sink":"bluez_output.XX.a2dp-sink","volume":0.8}}
# Windows WASAPI example: {"living-room":{"driver":"wasapi","sink":"{endpoint-id}","volume":0.8}}
TANK_AUDIO_ROOM_SINKS={}

# Required only when this worker runs on Windows with a WASAPI room sink.
TANK_AUDIO_WASAPI_PLAYER=C:\\tank-audio\\TankAudioPlayer.exe

# Primary TTS. Voice IDs remain server-only behind aliases.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TANK_TTS_VOICES={"default":"REPLACE_WITH_VOICE_ID"}

# Optional OpenAI-compatible local fallback such as kokoro-open-tts.
LOCAL_TTS_BASE_URL=http://kokoro-tts:8880
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart
