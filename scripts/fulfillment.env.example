# Shop provider fulfillment. All values are server-only; never prefix with
# NEXT_PUBLIC_. Keep separate secrets in each UNAXIS environment.

# Stripe is the authoritative payment mode. Vendor dispatch must match it:
# STRIPE_SHOP_MODE=test -> verified provider sandbox only
# STRIPE_SHOP_MODE=live -> live provider only
# Providers without a verified sandbox remain blocked during Stripe test mode.

# Long random secret used only by the internal nightly catalog reconciliation
# endpoint. The scheduler sends it as x-fulfillment-sync-secret.
FULFILLMENT_SYNC_SECRET=

# Apliiq custom store
APLIIQ_APP_ID=
APLIIQ_SHARED_SECRET=
APLIIQ_CALLBACK_TOKEN=
FULFILLMENT_APLIIQ_ENVIRONMENT=live
# Configure the four Apliiq callback fields with these paths and append
# ?token=<APLIIQ_CALLBACK_TOKEN> to each URL:
# /api/integrations/apliiq/products
# /api/integrations/apliiq/product-search
# /api/integrations/apliiq/fulfillment
# /api/integrations/apliiq/warehouse-shipment-complete

# Gelato API Portal
GELATO_API_KEY=
GELATO_API_KEY_TEST=
GELATO_API_KEY_LIVE=
GELATO_STORE_ID=
GELATO_WEBHOOK_SECRET=
FULFILLMENT_GELATO_ENVIRONMENT=sandbox

# Printful public app / generated access credentials
PRINTFUL_CLIENT_ID=
PRINTFUL_CLIENT_SECRET=
PRINTFUL_ACCESS_KEY=
# Optional simpler path for a single-store integration
PRINTFUL_PRIVATE_TOKEN=
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
FULFILLMENT_PRINTFUL_ENVIRONMENT=sandbox

# Gooten API settings
GOOTEN_RECIPE_ID=
GOOTEN_PARTNER_BILLING_KEY=
GOOTEN_WEBHOOK_SECRET=
FULFILLMENT_GOOTEN_ENVIRONMENT=sandbox

# Fourthwall Open API + Storefront API
FOURTHWALL_API_USERNAME=
FOURTHWALL_API_PASSWORD=
FOURTHWALL_STOREFRONT_TOKEN=
FOURTHWALL_WEBHOOK_SECRET=
